# MySQL Database Configuration
# Copy this file to '.env' and fill in your actual passwords/credentials.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GIT.

# Root password for MySQL server instance
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# General user configurations (matches your spring application-dev properties)
MYSQL_DATABASE=Community_Board_DB
MYSQL_USER=board_admin
MYSQL_PASSWORD=your_db_user_password_here
